<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.css311_gui_basic.GUIController"
      stylesheets="@style.css"
      alignment="CENTER"
      spacing="25.0"
      prefHeight="400.0"
      prefWidth="500.0">

    <padding>
        <Insets top="30.0"
                right="30.0"
                bottom="30.0"
                left="30.0"/>
    </padding>

    <children>

        <!-- Displays my name with rotation and CSS styling -->
        <Label fx:id="nameLabel"
               text="Shahla Tasnim Meem"
               rotate="-10.0"
               styleClass="name-label"/>

        <!-- Changes the label text and rotation when clicked -->
        <Button text="Click Me"
                onAction="#buttonPressed"
                styleClass="action-button"
                mnemonicParsing="false"/>

        <!-- Contains the movable shapes -->
        <HBox alignment="CENTER"
              spacing="30.0">

            <children>

                <!-- Movable circle -->
                <Circle fx:id="circle"
                        radius="40.0"
                        fill="#42A5F5"/>

                <!-- Movable rounded rectangle -->
                <Rectangle fx:id="rectangle"
                           width="90.0"
                           height="70.0"
                           arcWidth="15.0"
                           arcHeight="15.0"
                           fill="#7E57C2"/>

            </children>
        </HBox>

        <!-- Instructions for the user -->
        <Label text="Drag the shapes with your mouse."
               style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>

    </children>
</VBox>